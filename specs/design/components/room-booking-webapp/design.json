{
  "name": "room-booking-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "room-booking-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F2.5",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "The single browser surface for Members: browse and search rooms, see a room's busy times, book a room, and list and cancel one's own bookings. A separate deployable only because it is the user-facing SPA; it holds no data of its own and calls room-booking-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "room-booking-api",
      "description": "Loads rooms, searches free rooms, reads busy times, and creates, lists and cancels the Member's bookings.",
      "wiring": {
        "endpoint": {
          "component": "booking-meeting-rooms-2-room-booking-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "ROOM_BOOKING_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs Members in through SSO.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "booking-meeting-r-2d5e8f17",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
